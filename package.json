{
  "name": "dsh-edit-retry",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Edit any user message and retry from that point: forks the session at the event before the message, opens the child, and sends the edited text. · 编辑任意一条用户消息并从那里重试。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huangmiuXyz/dsh-edit-retry.git"
  },
  "homepage": "https://github.com/huangmiuXyz/dsh-edit-retry#readme",
  "bugs": {
    "url": "https://github.com/huangmiuXyz/dsh-edit-retry/issues"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "edit",
    "retry",
    "fork",
    "session"
  ],
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node test/check.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-chat"
      ]
    }
  }
}
